{
  "manifest_version": 3,
  "name": "JobToFill",
  "short_name": "JobToFill",
  "version": "1.0.0",
  "description": "Autofill job applications and everyday forms: contact details, address, education, work history, resumes, screening questions, passwords and cards.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JobToFill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the current page"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" }
    }
  }
}
