{
  "name": "jobtofill",
  "version": "1.2.0",
  "private": true,
  "description": "Browser extension that autofills job applications and everyday forms.",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:firefox": "BROWSER=firefox node --test --test-concurrency=1 tests/e2e/fill.test.mjs tests/e2e/pages.test.mjs tests/e2e/letter.test.mjs tests/e2e/upload.test.mjs tests/e2e/answers.test.mjs tests/e2e/education.test.mjs tests/e2e/stubborn.test.mjs tests/e2e/editors.test.mjs tests/e2e/dynamic.test.mjs tests/e2e/lib-mui.test.mjs tests/e2e/lib-antd.test.mjs tests/e2e/lib-headless.test.mjs tests/e2e/lib-jquery.test.mjs tests/e2e/lib-forms.test.mjs tests/e2e/workday.test.mjs tests/e2e/screening.test.mjs tests/e2e/snapshot.test.mjs tests/e2e/pagemap.test.mjs tests/e2e/pagemap-ui.test.mjs tests/e2e/phenom.test.mjs tests/e2e/bamboohr.test.mjs",
    "lint": "eslint . && prettier --check . && node scripts/check.mjs && npm run build --silent && web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "format": "prettier --write . && eslint --fix .",
    "build": "node scripts/build.mjs",
    "sign:firefox": "node scripts/firefox-release.mjs",
    "chrome": "web-ext run --target chromium",
    "firefox": "web-ext run --target firefox-desktop",
    "demo": "node tests/fixtures/serve.mjs",
    "icons": "node scripts/icons.mjs",
    "firms": "node scripts/firms.mjs",
    "pagemap": "node scripts/pagemap.mjs",
    "eval": "node tests/eval/run.mjs",
    "eval:build": "node tests/eval/build.mjs",
    "eval:scoreboard": "node tests/eval/scoreboard.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@headlessui/react": "^2.2.10",
    "@lexical/history": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@tiptap/core": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "antd": "^6.6.5",
    "choices.js": "^11.2.4",
    "chosen-js": "^1.8.7",
    "dayjs": "^1.11.23",
    "downshift": "^9.4.0",
    "element-plus": "^2.14.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "formik": "^2.4.9",
    "globals": "^17.13.0",
    "inputmask": "^5.0.10",
    "intl-tel-input": "^29.5.3",
    "jquery": "^4.0.0",
    "jquery-ui-dist": "^1.13.3",
    "lexical": "^0.52.0",
    "linkedom": "^0.18.13",
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "quill": "^2.0.3",
    "react": "^19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-imask": "^7.6.1",
    "react-phone-number-input": "^3.4.18",
    "react-select": "^5.10.2",
    "select2": "^4.0.13",
    "tom-select": "^2.6.2",
    "vue": "^3.5.43",
    "web-ext": "^10.7.0",
    "yup": "^1.7.1"
  },
  "engines": {
    "node": ">=20"
  }
}
